Dtk--Widget--DTextButton {
    padding:0 12px;
    min-width:62px;
    color:#d0d0d0;
    outline:none;
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}

Dtk--Widget--DTextButton:hover {
    background-color: rgba(0, 140, 255, 0.10);
    border-color: rgba(0, 140, 255, 0.28);
    color:#4cc2ff;
}

Dtk--Widget--DTextButton:pressed {
    background-color: rgba(0, 140, 255, 0.18);
}

Dtk--Widget--DTextButton:checked {
    color:#4cc2ff;
    border-color: rgba(0, 140, 255, 0.35);
    background-color: rgba(0, 140, 255, 0.10);
}
