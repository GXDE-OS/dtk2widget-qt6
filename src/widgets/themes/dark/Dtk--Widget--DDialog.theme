Dtk--Widget--DDialog{
    qproperty-backgroundColor: rgba(30, 31, 35, 0.86);
    qproperty-borderColor: rgba(255, 255, 255, 0.06);
}

QFrame#ButtonFrame{
    border:1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.03);
}

#CloseButton{
    qproperty-normalPic: url(:/images/dialog_close_round_normal.png);
    qproperty-hoverPic: url(:/images/dialog_close_round_hover.png);
    qproperty-pressPic: url(:/images/dialog_close_round_press.png);
}

QPushButton#NormalButton{
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    color: #e6e6e6;
    text-align: center;
}

QPushButton#NormalButton:hover{
    background-color: rgba(0, 140, 255, 0.10);
    border-color: rgba(0, 140, 255, 0.28);
    color: #4cc2ff;
}

QPushButton#NormalButton:pressed{
    background-color: rgba(0, 140, 255, 0.18);
    color: #4cc2ff;
}

QPushButton#ActionButton{
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-right: none;
    border-left: none;
    border-bottom: none;
    font-size: 13px;
    color: #d0d0d0;
    text-align: center;
    outline: none;
}

QPushButton#ActionButton[buttonType="1"] {/*warning*/
    color: #ff6b6b;
    font-weight: 500;
}

QPushButton#ActionButton[buttonType="2"] {/*recommend*/
    color: #4cc2ff;
    font-weight: 500;
}

QPushButton#ActionButton:hover{
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #8ccfff, stop:1 #4bb8ff);
    color: #ffffff;
}

QPushButton#ActionButton:pressed{
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #0b8cff, stop:1 #0aa1ff);
    color: #ffffff;
}

QPushButton#ConflictButton{
    background-color: transparent;
    border:none;
    color: white;
    text-align: center;
}

QPushButton#ConflictButton:checked{
    background-color: #ff9327;
}

QLabel#VLine{
    background-color:rgba(255, 255, 255, 0.10);
}

QLabel#TitleLabel{
    padding-top: 2px;
    padding-bottom: 2px;
    color: #f0f0f0;
}

QLabel#MessageLabel{
    padding-top: 2px;
    padding-bottom: 2px;
    color: #b8b8b8;
}

QLabel#TaskTitleLabel{
   padding-top: 2px;
   padding-bottom: 2px;
   font-size: 10px;
   color: #808080;
}

QListWidget{
    background-color: transparent;
}
