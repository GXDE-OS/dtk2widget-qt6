Dtk--Widget--DTextButton {
    padding:0 12px;
    min-width:64px;
    color:#2c2c2c;
    outline:none;
    background-color: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
}

Dtk--Widget--DTextButton:hover {
    background-color: rgba(0, 120, 255, 0.08);
    border-color: rgba(0, 120, 255, 0.25);
    color:#0078d4;
}

Dtk--Widget--DTextButton:pressed {
    background-color: rgba(0, 120, 255, 0.16);
}

Dtk--Widget--DTextButton:checked {
    color:#0078d4;
    border-color: rgba(0, 120, 255, 0.35);
    background-color: rgba(0, 120, 255, 0.08);
}
